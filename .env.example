# BotFather'dan olingan token
BOT_TOKEN=0000000000:AAAA-your-telegram-bot-token-here

# Toshstat.uz rasmiy sayti manzili
WEBSITE_URL=https://toshstat.uz

# PostgreSQL ulanish satri
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Dokployda Postgres xizmatini yaratganda "Internal Connection URL" nomi
# bilan tayyor holda beriladi (README dagi "Dokploy" bo'limiga qarang).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toshstat_bot

# Reyting bo'limini yoqish/o'chirish (true/false)
SHOW_LEADERBOARD=true

# Reytingda foydalanuvchi ismi ko'rsatilsinmi, yoki anonim (true = ism, false = anonim)
LEADERBOARD_SHOW_NAMES=false
